rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // MeMyMate by ARCT — cloud writes are reserved for real (non-anonymous)
    // email/password accounts. Guests never perform Firestore I/O.
    function isCloudAccount() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    match /users/{userId} {
      allow read, write: if isCloudAccount() && request.auth.uid == userId;

      match /knights/{knightId} {
        allow read, write: if isCloudAccount() && request.auth.uid == userId;
      }
    }

    match /sharedKnights/{knightId} {
      // Public read-only study links: anyone can open and study a share link.
      allow read: if true;
      // Only real accounts may publish, and only to their own ownerId.
      allow create, update: if isCloudAccount()
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isCloudAccount()
        && resource.data.ownerId == request.auth.uid;
    }
  }
}
